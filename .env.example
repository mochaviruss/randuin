# Plantilla del .env del servidor. Copiala a .env (que esta en .gitignore y NUNCA se sube) y completa los valores.
# Aqui no hay valores reales. Las contrasenas y la clave de API las eliges tu y quedan solo en el servidor.

# --- Obligatorias: sin ellas docker compose se detiene y lo dice ---------------------------------------------------------
# Clave que exige el gateway en el header X-API-Key (sin ella: 401). La usa tambien el dominio para llamar a ia.
API_KEY=cambia-esto-por-una-clave-larga-y-al-azar
POSTGRES_PASSWORD=cambia-esto-por-otra-contrasena

# --- Despliegue ------------------------------------------------------------------------------------------------------------
# Nombre con el que Caddy pide el certificado: <ip-elastica-con-guiones>.sslip.io (EP3, 2.4). En local: localhost.
DOMINIO=localhost
# Tag de las imagenes de GHCR. La entrega es ep3; para probar una version puntual: sha-xxxxxxx.
TAG=ep3

# --- Modelo en SageMaker ---------------------------------------------------------------------------------------------------
# ia invoca este endpoint con el ROL de la EC2 (LabInstanceProfile). No hay ni se necesitan claves de acceso de AWS.
ENDPOINT=randuin-fraude
AWS_DEFAULT_REGION=us-east-1
# Cuanto espera ia a SageMaker (segundos). Un cold start tarda ~6 s medidos: 10 s lo cubren.
SAGEMAKER_TIMEOUT=10
# Cuanto espera el dominio al modelo antes de la politica de reserva (milisegundos). RNF3 del caso: 100 ms, y el core corta
# a los 150 ms en total (RT3): no lo subas sin una razon medida. Con SageMaker serverless algunas decisiones saldran por la
# reserva (origen = 'reserva'): cuantas, lo dice la prueba de carga.
IA_TIMEOUT_MS=100

# --- Base de datos (solo accesible dentro de la red de compose) -------------------------------------------------------------
POSTGRES_USER=randuin
POSTGRES_DB=randuin
