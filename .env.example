# Opcional. El compose.yaml funciona SIN este archivo: estos son los valores por defecto (de ejemplo, no reales).
# Para cambiarlos: copiar a .env (que esta en .gitignore y nunca se sube) y editar.
POSTGRES_USER=randuin
POSTGRES_PASSWORD=randuin_local
POSTGRES_DB=randuin
# Clave que exige el gateway para llamar al modelo (/api/ia/predict, header X-API-Key). La usa el dominio.
API_KEY=randuin-local
# Cuanto espera el dominio al modelo antes de aplicar la politica de reserva (RNF3)
IA_TIMEOUT_MS=100
