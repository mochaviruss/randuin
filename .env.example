# Plantilla del .env del servidor. Copiala a .env (que esta en .gitignore y NUNCA se sube) y completa los valores.
# Aqui no hay valores reales. Las contrasenas y la clave de API las eliges tu y quedan solo en el servidor.

# --- Obligatorias: sin ellas docker compose se detiene y lo dice ---------------------------------------------------------
# Clave que exige el gateway en el header X-API-Key (sin ella: 401). La usa tambien el dominio para llamar a ia.
API_KEY=cambia-esto-por-una-clave-larga-y-al-azar
POSTGRES_PASSWORD=cambia-esto-por-otra-contrasena

# --- Despliegue ------------------------------------------------------------------------------------------------------------
# Nombre con el que Caddy pide el certificado: <ip-elastica-con-guiones>.sslip.io (EP3, 2.4). En local: localhost.
DOMINIO=localhost
# Tag de las imagenes de GHCR. La entrega es ep3; para probar una version puntual: sha-xxxxxxx.
TAG=ep3

# Limite de peticiones por minuto y por cliente a /api/*: pasado el limite el gateway responde 429 (EP3, 2.5).
# 120 es un uso normal. Para la prueba de carga con Locust sube este valor (p. ej. 100000), o medirias el limite y no el sistema;
# para demostrar el 429 bajalo (p. ej. 20). Despues de cambiarlo: docker compose up -d gateway
LIMITE_POR_MINUTO=120

# --- Modelo en SageMaker ---------------------------------------------------------------------------------------------------
# ia invoca este endpoint con el ROL de la EC2 (LabInstanceProfile). No hay ni se necesitan claves de acceso de AWS.
ENDPOINT=randuin-fraude
AWS_DEFAULT_REGION=us-east-1
# Cuanto espera ia a SageMaker (segundos). Un cold start tarda ~6 s medidos: 10 s lo cubren.
SAGEMAKER_TIMEOUT=10
# Cuanto espera el dominio al modelo antes de la politica de reserva (milisegundos). RNF3 del caso: 100 ms, y el core corta
# a los 150 ms en total (RT3): no lo subas sin una razon medida. Con SageMaker serverless algunas decisiones saldran por la
# reserva (origen = 'reserva'): cuantas, lo dice la prueba de carga.
IA_TIMEOUT_MS=100

# --- Cola y LLM (EP3) ---------------------------------------------------------------------------------------------------------
# RabbitMQ: usuario y contrasena propios (el "guest" solo acepta conexiones locales). Usa letras y numeros: va dentro de una URL.
RABBITMQ_USER=randuin
RABBITMQ_PASSWORD=cambia-esto-por-otra-contrasena
# La API de NVIDIA (compatible con la de OpenAI). La clave la creas tu en build.nvidia.com y NUNCA se sube. Si queda vacia el
# sistema igual predice: el resumen sale degradado.
NVIDIA_API_KEY=
# PROVISORIO: este es el modelo que usa la guia del curso (respondio en ~0,6 s el 17-11-2026), mientras el docente no publica
# el suyo. El modelo OBLIGATORIO es el que se publique en el foro de la asignatura (el mismo para los ocho equipos): cuando
# aparezca, cambia SOLO esta linea en el .env del servidor y corre `docker compose up -d worker` (restart no relee el .env).
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Segundos por intento, intentos en total y ritmo minimo entre llamadas (la capa gratuita ronda las 40 por minuto: 1,6 s son 37).
NVIDIA_TIMEOUT=20
NVIDIA_INTENTOS=4
LLM_MIN_INTERVALO_S=1.6

# --- Base de datos (solo accesible dentro de la red de compose) -------------------------------------------------------------
POSTGRES_USER=randuin
POSTGRES_DB=randuin
