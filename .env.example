# Opcional. El compose funciona SIN este archivo: estos son los valores por defecto.
# Para cambiarlos: copiar a .env (que esta en .gitignore) y editar.
POSTGRES_USER=randuin
POSTGRES_PASSWORD=randuin_local
POSTGRES_DB=randuin
# Cuanto espera la API de Decision al Motor de Inferencia antes de aplicar la politica de reserva (EP1, cap. 8.2)
IA_TIMEOUT_MS=100
# Que decide la API si el Motor de Inferencia no responde a tiempo:
#   reglas (fail-open a reglas basicas, objetivo de calidad 3 de la EP1) | aprobar | revisar | bloquear
POLITICA_RESERVA=reglas
# Usuarios de Riesgo que pueden cambiar umbrales y modo sombra/activo (RO5), separados por coma
AUTORIZADOS_UMBRALES=ibravo
